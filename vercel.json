{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/bpth",
      "destination": "/BPTH/index.html"
    },
    {
      "source": "/bpth/",
      "destination": "/BPTH/index.html"
    },
    {
      "source": "/baogia-BPTH",
      "destination": "/baogia-bpth/index.html"
    },
    {
      "source": "/baogia-BPTH/",
      "destination": "/baogia-bpth/index.html"
    },
    {
      "source": "/qlch",
      "destination": "/qlch/index.html"
    },
    {
      "source": "/qlch/",
      "destination": "/qlch/index.html"
    }
  ],
  "headers": [
    {
      "source": "/baogia-bpth/gia-can.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/qlch(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/qlch/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
